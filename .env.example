# Copy to .env and fill in what you have. .env is git-ignored.
# You can also paste keys into the web app's Keys tab; those stay in memory only.

# --- Agents (behaviour) ---
# Claude, and the Claude judge: https://console.anthropic.com
ANTHROPIC_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OpenRouter, one key for hundreds of models (Llama, Qwen, DeepSeek, Gemini...): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Google Gemini (via its OpenAI-compatible endpoint): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any other OpenAI-compatible endpoint (Groq, Together, a local Ollama at http://localhost:11434/v1, ...)
CUSTOM_API_KEY=
CUSTOM_BASE_URL=

# --- Inside the model (activations) ---
# NDIF (free): https://login.ndif.us
NDIF_API_KEY=
# Hugging Face token, for gated models like Llama and Gemma: https://huggingface.co/settings/tokens
# Also accept the license on the model's Hugging Face page.
HF_TOKEN=
